# =====================================================================
# AI Interview Assistant Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with secrets into version control.
# =====================================================================

# --- Groq LLM Configuration ---
# Required: Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Preferred model on Groq (defaults to qwen/qwen3.8-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# --- RAG & Vector Database Settings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=3

# --- FastAPI Backend Settings ---
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60/minute

# --- File Upload Limits ---
MAX_FILE_SIZE_MB=10
